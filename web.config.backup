      <aspNetCore processPath="dotnet" arguments=".\TRAINERS.WEB.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
